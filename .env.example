# ClearKorea environment contract (names only; real values live in .env, never commit them)
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.

# === Supabase (core) ===
# Project URL is a public, non-secret identifier (also hardcoded in src/lib/supabase/project.ts).
NEXT_PUBLIC_SUPABASE_URL=https://ffranmygjhmbitmtlkiw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# === Auth: Kakao / Naver OAuth (server-only) ===
SUPABASE_AUTH_KAKAO_CLIENT_ID=
SUPABASE_AUTH_KAKAO_CLIENT_SECRET=
SUPABASE_AUTH_NAVER_CLIENT_ID=
SUPABASE_AUTH_NAVER_CLIENT_SECRET=

# === Admin allowlists (provider-qualified IDs: kakao:<subject> / custom:naver:<subject>) ===
SUPER_ADMIN_PROVIDER_IDS=
ADMIN_PROVIDER_IDS=

# === App subdomain origin (marketing Enter link / cross-subdomain login) ===
# Public, non-secret. Production: https://app.clearkorea.com
# Local cross-subdomain test: http://app.clearkorea.local:3000 (leave blank for single-host dev)
NEXT_PUBLIC_APP_ORIGIN=

# === Launch / dev (true only in non-production for QA) ===
CLEAR_KOREA_ENABLE_DEV_GUEST_BYPASS=false

# === Features ===
SEOUL_CITYDATA_API_KEY=

# === Abuse prevention: Cloudflare Turnstile ===
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# === Observability: PostHog ===
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# === AI moderation ===
OPENAI_API_KEY=
