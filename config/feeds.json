{
  "meta": {
    "name": "ClearKorea 해외언론 피드 설정",
    "updated": "2026-06-07",
    "notes": [
      "checked=true 는 검색·런타임에서 확인된 피드, checked=false 는 표준이지만 런타임 검증 권장.",
      "Reuters/AP/AFP/Bloomberg/FT/WSJ 등은 공개 RSS가 제한·중단되어 googleNews 쿼리로 커버한다.",
      "googleNews 가 핵심 catch-all. outlets 직접 RSS는 신뢰 출처 우선 노출용.",
      "수집 후 keywordFilter 를 반드시 적용해서 한국 선거 관련 항목만 통과시킬 것.",
      "cbc-world: 피드 URL은 정상(브라우저 UA로 HTTP 200 + 유효 RSS)이지만 CBC CDN이 자동화 봇 User-Agent를 HTTP/2 reset 으로 차단해 check-feeds.mjs 로는 검증 불가 → checked=false 로 유지.",
      "kyodo-en: 공개 RSS 가 중단(404)되어 검증된 라이브 일본 영문 통신사 피드인 Nikkei Asia 로 교체함."
    ]
  },

  "keywordFilter": {
    "logic": "AND",
    "match": ["title", "description"],
    "groups": {
      "en": {
        "korea": ["South Korea", "Korean", "Seoul"],
        "topic": ["election", "ballot", "vote", "electoral", "recount", "polling", "vote-counting", "by-election", "local elections"]
      },
      "ja": {
        "korea": ["韓国", "ソウル"],
        "topic": ["選挙", "投票", "開票", "不正選挙", "再選挙", "投票用紙"]
      },
      "es": {
        "korea": ["Corea del Sur", "Seúl"],
        "topic": ["elección", "elecciones", "votación", "recuento", "comicios"]
      },
      "fr": {
        "korea": ["Corée du Sud", "Séoul"],
        "topic": ["élection", "scrutin", "vote", "dépouillement"]
      },
      "de": {
        "korea": ["Südkorea", "Seoul"],
        "topic": ["Wahl", "Wahlen", "Stimmzettel", "Auszählung"]
      },
      "ar": {
        "korea": ["كوريا الجنوبية", "سيول"],
        "topic": ["انتخابات", "تصويت", "فرز", "اقتراع"]
      }
    },
    "boost": ["Jamsil", "ballot shortage", "NEC", "National Election Commission", "투표용지", "再選挙", "olympic park"]
  },

  "googleNews": {
    "endpoint": "https://news.google.com/rss/search",
    "buildHint": "url = `${endpoint}?q=${encodeURIComponent(q)}&hl=${hl}&gl=${gl}&ceid=${ceid}`",
    "timeWindowHint": "최근만 원하면 q 끝에 ' when:7d' 또는 ' when:30d' 추가",
    "queries": [
      { "id": "en-us", "q": "\"South Korea\" (election OR ballot OR vote OR electoral OR recount)", "hl": "en-US", "gl": "US", "ceid": "US:en" },
      { "id": "en-gb", "q": "\"South Korea\" (election OR ballot OR vote OR electoral OR recount)", "hl": "en-GB", "gl": "GB", "ceid": "GB:en" },
      { "id": "en-in", "q": "\"South Korea\" (election OR ballot OR vote OR recount)", "hl": "en-IN", "gl": "IN", "ceid": "IN:en" },
      { "id": "en-au", "q": "\"South Korea\" (election OR ballot OR vote OR recount)", "hl": "en-AU", "gl": "AU", "ceid": "AU:en" },
      { "id": "en-sg", "q": "\"South Korea\" (election OR ballot OR vote OR recount)", "hl": "en-SG", "gl": "SG", "ceid": "SG:en" },
      { "id": "ja-jp", "q": "韓国 (選挙 OR 投票 OR 開票 OR 再選挙)", "hl": "ja", "gl": "JP", "ceid": "JP:ja" },
      { "id": "es-es", "q": "\"Corea del Sur\" (elecciones OR votación OR recuento)", "hl": "es", "gl": "ES", "ceid": "ES:es" },
      { "id": "es-mx", "q": "\"Corea del Sur\" (elecciones OR votación OR recuento)", "hl": "es-419", "gl": "MX", "ceid": "MX:es-419" },
      { "id": "fr-fr", "q": "\"Corée du Sud\" (élection OR scrutin OR vote OR dépouillement)", "hl": "fr", "gl": "FR", "ceid": "FR:fr" },
      { "id": "de-de", "q": "Südkorea (Wahl OR Stimmzettel OR Auszählung)", "hl": "de", "gl": "DE", "ceid": "DE:de" },
      { "id": "it-it", "q": "\"Corea del Sud\" (elezioni OR voto OR scrutinio)", "hl": "it", "gl": "IT", "ceid": "IT:it" },
      { "id": "pt-br", "q": "\"Coreia do Sul\" (eleição OR votação OR apuração)", "hl": "pt-BR", "gl": "BR", "ceid": "BR:pt-419" },
      { "id": "ar", "q": "\"كوريا الجنوبية\" (انتخابات OR تصويت OR فرز)", "hl": "ar", "gl": "EG", "ceid": "EG:ar" },
      { "id": "tr", "q": "\"Güney Kore\" (seçim OR oy OR sandık)", "hl": "tr", "gl": "TR", "ceid": "TR:tr" },
      { "id": "ru", "q": "\"Южная Корея\" (выборы OR голосование OR бюллетень)", "hl": "ru", "gl": "RU", "ceid": "RU:ru" },
      { "id": "specific-en", "q": "South Korea (Jamsil OR \"ballot shortage\" OR \"vote counting\" OR re-election OR recount)", "hl": "en-US", "gl": "US", "ceid": "US:en" }
    ]
  },

